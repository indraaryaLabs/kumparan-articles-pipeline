# Copy to .env (`make env` does it for you).
# On Linux set this to the output of `id -u` so files in ./logs and ./data are yours.
AIRFLOW_UID=50000

# Minutes each hourly run looks back before its own window (late commits, replica lag).
LOOKBACK_MINUTES=15

# Optional: Slack incoming webhook for failure alerts.
SLACK_WEBHOOK_URL=

# Any long random string; shared by the Airflow components to sign internal tokens.
AIRFLOW_JWT_SECRET=local_dev_jwt_secret_change_me
